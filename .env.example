DATABASE_URL="postgresql://user:password@host:5432/vendra?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-string"

# Stabilizes Server Action reference encryption across builds/instances
# (recommended by Next.js for serverless deployments like Vercel).
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-openssl-rand--base64-32-output"

# Optional: AI autofill on "New Purchase Request" (text or quote photo/PDF).
# Free key: https://aistudio.google.com/apikey . Leave unset to hide the feature.
GEMINI_API_KEY=""
# Optional model override; falls back to gemini-2.5-flash if unavailable.
# GEMINI_MODEL="gemini-3.5-flash"
