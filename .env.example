DATABASE_URL="postgresql://user:password@host:5432/vendra?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-string"

# Stabilizes Server Action reference encryption across builds/instances
# (recommended by Next.js for serverless deployments like Vercel).
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-openssl-rand--base64-32-output"
